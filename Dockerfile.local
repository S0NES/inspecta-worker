# Runtime-only image for the LOCAL all-Docker dev stack (docker-compose.local.yml).
# Jar built on the host (mvn package) — no Reposilite needed. Prod uses ./Dockerfile.
# Base = jammy (glibc), not alpine: webp-imageio ships glibc-linked natives and the
# image/PDF pipeline needs fontconfig/freetype (same reasoning as ./Dockerfile).
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends fontconfig fonts-dejavu-core curl \
 && rm -rf /var/lib/apt/lists/*
COPY target/*.jar app.jar
EXPOSE 8081
HEALTHCHECK --interval=15s --timeout=3s --retries=10 --start-period=90s \
  CMD curl -fsS http://localhost:8081/actuator/health | grep -q UP || exit 1
ENTRYPOINT ["java","-XX:MaxRAMPercentage=75","-jar","app.jar"]
