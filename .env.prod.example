# ============================================================================
# inspecta-worker/.env.prod — copie para .env.prod na VPS e preencha.
#   cp .env.prod.example .env.prod && nano .env.prod
#
# No profile `prod` o inspecta-worker FALHA O BOOT se qualquer variável obrigatória
# estiver ausente (T7.5). Restart loop = ler `docker compose logs inspecta-worker`.
# NUNCA commitar .env.prod.
# ============================================================================

# --- Rede docker -----------------------------------------------------------

# --- Banco (OBRIGATÓRIO) ---------------------------------------------------
DATABASE_URL=jdbc:postgresql://inspecta-postgres-ostetc:5432/inspecta
DATABASE_USER=inspecta
DATABASE_PASSWORD=MESMA_SENHA_DO_INFRA_ENV

# --- RabbitMQ (OBRIGATÓRIO) ------------------------------------------------
RABBITMQ_HOST=inspecta-rabbitmq-i6kk2u
RABBITMQ_PORT=5672
RABBITMQ_USER=inspecta
RABBITMQ_PASSWORD=MESMA_SENHA_DO_INFRA_ENV

# --- Pagamento / AbacatePay (OBRIGATÓRIO) ----------------------------------
PAYMENT_PROVIDER=abacatepay
ABACATEPAY_API_KEY=
# Métodos de pagamento aceitos no link (PIX, CARD, BOLETO — ver docs.abacatepay.com).
# Opcional (tem default no application.yml).
PAYMENT_METHODS=PIX,CARD

# --- Pleno (OBRIGATÓRIO) ---------------------------------------------------
PLENO_MODE=http
PLENO_BASE_URL=https://SEU-SUBDOMINIO.sistemaspleno.com
PLENO_CLIENT_ID=
PLENO_CLIENT_SECRET=

# --- Assinatura / lembrete de assinatura pendente (opcional) --------------
# O IO com a Autentique (createDocument, webhook, PDF) roda no inspecta-messenger — ver inspecta-messenger/.env.prod.example
# (SIGNATURE_BROKER / AUTENTIQUE_API_KEY / AUTENTIQUE_API_URL / AUTENTIQUE_SANDBOX).
# Aqui só o cron que reenvia o link pra quem ainda não assinou (janela = validade do link, 7d).
SIGNATURE_REMINDER_ENABLED=true
SIGNATURE_REMINDER_CRON=0 0 8 * * *
SIGNATURE_REMINDER_WINDOW_DAYS=7
SIGNATURE_REMINDER_SPACING_HOURS=72

# --- Opcionais (têm default no application.yml) ----------------------------
PLENO_POLL_MS=60000
PLENO_TOKEN_TTL_SECONDS=240
# De-para Pleno (T6.16) — só setar se a instância Pleno do cliente usar outros
# códigos. Defaults abaixo = InspectaSystem v1.
#
# ATENÇÃO: PLENO_DEPARA_TIP_IMO_CODIGO **varia por tenant** (Q6/Q9) — revise por
# ambiente. Ainda pendente de confirmação no tenant alvo: código de vistoria de
# "conferência" (tip-vis), tipo de imóvel "apartamento" (tip-imo),
# GRU_CODIGO_VISTORIADOR e USU_CODIGO_MODELO (rodar os GET read-only da Pleno).
#
# Mapas: lista "chave:codigo" separada por vírgula. A chave casa por substring
# (normalizada, sem acento) contra imoveis.tipo / tipos_servico.nome / papel.
PLENO_DEPARA_TIP_IMO_CODIGO=36
PLENO_DEPARA_TIP_IMO_POR_TIPO=casa:14
PLENO_DEPARA_TIP_VIS_CODIGO=2
PLENO_DEPARA_TIP_VIS_POR_NOME=entrada:2,saida:6
PLENO_DEPARA_GRU_CODIGO_VISTORIADOR=15
# usu_codigo_modelo: vazio = não envia no usuario/adicionar.
PLENO_DEPARA_USU_CODIGO_MODELO=
PLENO_DEPARA_CLI_CONTESTACAO_DIAS=5
PLENO_DEPARA_TIP_FUN_POR_PAPEL=locador:5,locatario:4,fiador:3,testemunha:6
PLENO_DEPARA_VISTORIADOR_SISTEMAS=6,3

# --- Runtime ---------------------------------------------------------------
IMAGE_TAG=latest
WORKER_REPLICAS=1
WORKER_MEM_LIMIT=2g
WORKER_SHM_SIZE=1gb
WORKER_JAVA_OPTS=-XX:MaxRAMPercentage=70
TZ=America/Sao_Paulo
